# Cortex server configuration.
# Copy to `.env`, edit values, then run:  uv run cortex
# Every variable is prefixed CORTEX_ and is optional; defaults shown below.

# Directory whose immediate subdirectories are bundles, named by folder.
CORTEX_BUNDLES_ROOT=examples/bundles

# Where the Chroma vector index persists on disk.
CORTEX_CHROMA_PATH=.cortex/chroma
CORTEX_CHROMA_COLLECTION=concepts

# Embedding provider: sentence-transformers (default), ollama, or vertex.
CORTEX_EMBEDDING_PROVIDER=sentence-transformers

# Uncomment when CORTEX_EMBEDDING_PROVIDER=ollama.
# CORTEX_OLLAMA_BASE_URL=http://localhost:11434
# CORTEX_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Uncomment when CORTEX_EMBEDDING_PROVIDER=vertex.
# CORTEX_VERTEX_PROJECT=your-gcp-project
# CORTEX_VERTEX_LOCATION=us-central1
# CORTEX_VERTEX_EMBEDDING_MODEL=text-embedding-005