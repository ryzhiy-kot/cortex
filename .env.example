# Cortex server configuration.
# Copy to `.env`, edit values, then run:  uv run cortex
# Every variable is prefixed CORTEX_ and is optional; defaults shown below.

# Directory whose immediate subdirectories are bundles, named by folder.
CORTEX_BUNDLES_ROOT=examples/bundles

# Where the Chroma vector index persists on disk.
CORTEX_CHROMA_PATH=.cortex/chroma
CORTEX_CHROMA_COLLECTION=concepts

# Where uploaded source material is staged before Prepare.
CORTEX_STAGING_PATH=.cortex/staging

# Where per-run trace files are written, one JSON-lines file per prepare job or
# ingest run (`prepare/<job_id>.jsonl`, `ingest/<run_id>.jsonl`); readable via
# GET /prepare/{job_id}/trace and GET /ingest/{run_id}/trace.
CORTEX_TRACES_PATH=.cortex/traces
# Trace files older than this many days are pruned at startup and after runs.
CORTEX_TRACE_RETENTION_DAYS=7

# JSON-lines log file (size-rotating) plus a console mirror for the cortex
# logger. Status transitions log at debug, failures at error with tracebacks.
CORTEX_LOG_PATH=.cortex/logs/cortex.log
# debug | info | warning | error
CORTEX_LOG_LEVEL=info

# Embedding provider: sentence-transformers (default), ollama, or vertex.
CORTEX_EMBEDDING_PROVIDER=sentence-transformers

# Uncomment when CORTEX_EMBEDDING_PROVIDER=ollama.
# CORTEX_OLLAMA_BASE_URL=http://localhost:11434
# CORTEX_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Uncomment when CORTEX_EMBEDDING_PROVIDER=vertex.
# CORTEX_VERTEX_PROJECT=your-gcp-project
# CORTEX_VERTEX_LOCATION=us-central1
# CORTEX_VERTEX_EMBEDDING_MODEL=text-embedding-005

# LLM provider used by Prepare (the authoring utility): ollama (default) or vertex.
# Prepare is the only endpoint that talks to an LLM; search and read never do.
CORTEX_LLM_PROVIDER=ollama

# Uncomment when CORTEX_LLM_PROVIDER=ollama.
# CORTEX_OLLAMA_LLM_MODEL=llama3.2

# Uncomment when CORTEX_LLM_PROVIDER=vertex.
# CORTEX_VERTEX_LLM_MODEL=gemini-2.0-flash-001